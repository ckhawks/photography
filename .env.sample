AWS_ACCESS_KEY_ID=accesskey
AWS_SECRET_ACCESS_KEY=secretkey
AWS_S3_REGION=us-west-1
AWS_S3_BUCKET=bucketname
# Set to an S3-compatible endpoint to read and write somewhere other than AWS,
# e.g. R2: https://<account-id>.r2.cloudflarestorage.com
# With it set, AWS_S3_REGION can be left blank and "auto" is used.
AWS_S3_ENDPOINT=
DATABASE_URL=neonurlhere
SECRET_PASSWORD=hunter2
NEXT_PUBLIC_BASE_URL=http://localhost:3010
# Serve photos straight off the bucket through Cloudflare instead of proxying
# them through /api/resource. Leave unset to keep using the proxy.
NEXT_PUBLIC_IMAGE_BASE_URL=https://photos-cdn.example.com
JWT_SECRET=1234